{
  "manifest_version": 3,
  "name": "UTHK Royal Shipment Sync",
  "version": "1.1.0",
  "description": "Syncs Royal shipments and statement details to the UTHK Google Sheet.",
  "permissions": [
    "alarms",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://member.royalx.biz/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://member.royalx.biz/shipment*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://member.royalx.biz/statement*"
      ],
      "js": [
        "statement-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "UTHK Royal Sync",
    "default_popup": "popup.html"
  }
}
